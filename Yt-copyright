import { EventEmitter } from 'events';
import { AuditLogEntry } from '../types/safety';

export class MultiChannelSafeUploader extends EventEmitter {
  private channels: Map<string, {
    client: youtube_v3.Youtube;
    config: ChannelConfig;
    dailyCount: number;
    safetyEngine: CopyrightSafetyEngine;
    monitor: PostPublicMonitor;
  }>;
  private taskQueue: VideoTask[] = [];
  private isProcessing: boolean = false;
  private auditLogs: AuditLogEntry[] = [];

  constructor() {
    super();
    this.channels = new Map();
  }

  /**
   * Registers a new channel with OAuth2 credentials
   */
  async registerChannel(config: ChannelConfig): Promise<void> {
    const jwtClient = new google.auth.JWT(
      config.clientEmail,
      undefined,
      config.privateKey.replace(/\\n/g, '\n'),
      [
        'https://www.googleapis.com/auth/youtube.upload',
        'https://www.googleapis.com/auth/youtube'
      ]
    );

    const youtube = google.youtube({ version: 'v3', auth: jwtClient });
    const safetyEngine = new CopyrightSafetyEngine(youtube);
    const monitor = new PostPublicMonitor(youtube);

    this.channels.set(config.channelId, {
      client: youtube,
      config,
      dailyCount: 0,
      safetyEngine,
      monitor
    });

    // Start post-public monitoring
    monitor.startMonitoring(config.channelId);

    // Schedule daily scans
    this.scheduleDailyScans(config);

    console.log(`✅ Channel registered: ${config.channelId} (Max: ${config.maxDailyUploads}/day)`);
    this.logAudit(config.channelId, 'register', `Channel initialized with score ${config.sourceReliabilityScore}`);
  }

  /**
   * Adds video task to queue with validation
   */
  async addTask(task: VideoTask): Promise<boolean> {
    const channelData = this.channels.get(task.targetChannelId);
    if (!channelData) {
      throw new Error(`Channel ${task.targetChannelId} not registered`);
    }

    // Check daily limit
    if (channelData.dailyCount >= channelData.config.maxDailyUploads) {
      console.warn(`⚠️ Daily limit reached for ${task.targetChannelId}`);
      return false;
    }

    // Check source reliability
    if (task.riskScore > channelData.config.sourceReliabilityScore) {
      console.warn(`⚠️ Task risk score ${task.riskScore} exceeds channel threshold ${channelData.config.sourceReliabilityScore}`);
      this.emit('humanApprovalRequired', { task, reason: 'high_risk_score' });
      return false;
    }

    this.taskQueue.push(task);
    this.logAudit(task.targetChannelId, 'queue', `Task ${task.id} added (Risk: ${task.riskScore})`);

    if (!this.isProcessing) {
      this.processQueue();
    }

    return true;
  }

  /**
   * Core processing pipeline with auto-delete/rerender loop
   */
  private async processQueue(): Promise<void> {
    if (this.taskQueue.length === 0 || this.isProcessing) return;
    this.isProcessing = true;

    while (this.taskQueue.length > 0) {
      const task = this.taskQueue.shift()!;
      const channelData = this.channels.get(task.targetChannelId)!;

      try {
        // STEP 1: Apply safety transformations (Fixes watermarks, raw audio)
        console.log(` Applying safety filters: ${task.id}`);
        const transformedPath = `/tmp/safe_${task.id}.mp4`;
        await FFMpegSafetyFilters.applySafetyTransformations(task.sourceUrl, transformedPath);

        // STEP 2: Upload as UNLISTED (Fixes direct public upload risk)
        console.log(`📤 Uploading unlisted: ${task.id}`);
        const uploadRes = await channelData.client.videos.insert({
          part: ['snippet', 'status'],
          requestBody: {
            snippet: {
              title: task.metadata.title,
              description: task.metadata.description,
              tags: task.metadata.tags,
              categoryId: '24' // Entertainment
            },
            status: { privacyStatus: 'unlisted' }
          },
          media: { body: require('fs').createReadStream(transformedPath) }
        });

        const videoId = uploadRes.data.id!;
        this.logAudit(task.targetChannelId, 'upload', `Unlisted upload: ${videoId}`);

        // STEP 3: Content ID safety check
        console.log(`🛡️ Running copyright check: ${videoId}`);
        const safetyResult = await channelData.safetyEngine.waitForContentIdProcessing(videoId);

        // STEP 4: Decision gate
        if (safetyResult.isSafe) {
          // Publish safely
          await channelData.client.videos.update({
            part: ['status'],
            requestBody: {
              id: videoId,
              status: { privacyStatus: 'public' }
            }
          });

          channelData.dailyCount++;
          this.logAudit(task.targetChannelId, 'publish', `Published: ${videoId}`);
          this.emit('published', { videoId, channelId: task.targetChannelId, task });

        } else {
          // AUTO-DELETE + RERENDER LOOP
          console.log(` Claim detected: ${safetyResult.claimType}. Action: ${safetyResult.actionRequired}`);
          
          const handled = await channelData.safetyEngine.executeSafetyAction(videoId, safetyResult);
          this.logAudit(task.targetChannelId, handled ? 'fix' : 'delete', `Claim handled: ${safetyResult.claimType}`);

          if (!handled && task.retryCount < task.maxRetries) {
            // Trigger rerender with stricter parameters
            task.retryCount++;
            console.log(`🔄 Rerender attempt ${task.retryCount}/${task.maxRetries} for ${task.id}`);
            
            this.emit('rerenderRequired', {
              taskId: task.id,
              reason: safetyResult.claimType,
              retryCount: task.retryCount,
              suggestedFilters: this.getStricterFilters(safetyResult.claimType)
            });
          } else {
            console.error(`💀 Max retries exceeded or permanent failure: ${task.id}`);
            this.emit('taskFailed', { taskId: task.id, reason: safetyResult.claimType });
            this.logAudit(task.targetChannelId, 'failed', `Permanent failure: ${safetyResult.claimType}`);
          }
        }

        // Cleanup temp file
        require('fs').unlinkSync(transformedPath);

      } catch (error) {
        console.error(`💥 Pipeline crash for ${task.id}:`, error);
        this.emit('error', { taskId: task.id, error });
        this.logAudit(task.targetChannelId, 'error', String(error));
      }
    }

    this.isProcessing = false;
  }

  /**
   * Returns stricter FFmpeg filters based on claim type
   */
  private getStricterFilters(claimType?: string): Record<string, number> {
    const base = { zoom: 1.08, speed: 1.03, brightness: 0.05 };
    
    if (claimType === 'audiovisual') {
      return { ...base, zoom: 1.12, speed: 1.05, brightness: 0.08 };
    }
    if (claimType === 'audio') {
      return { ...base, speed: 1.06, pitchShift: 2.0 };
    }
    return base;
  }

  /**
   * Schedules daily scan times per channel
   */
  private scheduleDailyScans(config: ChannelConfig): void {
    config.scanTimes.forEach(time => {
      const [hours, minutes] = time.split(':').map(Number);
      console.log(`⏰ Scheduled scan: ${config.channelId} at ${time}`);
      // TODO: Integrate node-cron for actual scheduling
    });
  }

  /**
   * Resets daily upload counters at midnight
   */
  resetDailyCounters(): void {
    this.channels.forEach(data => {
      data.dailyCount = 0;
    });
    console.log('🔄 Daily counters reset');
  }

  /**
   * Audit logging for debugging & compliance
   */
  private logAudit(channelId: string, action: AuditLogEntry['action'], details: string): void {
    const entry: AuditLogEntry = {
      timestamp: new Date(),
      channelId,
      action,
      details
    };
    this.auditLogs.push(entry);
    
    // Keep last 1000 entries
    if (this.auditLogs.length > 1000) {
      this.auditLogs.shift();
    }
  }

  /**
   * Get audit logs
   */
  getAuditLogs(channelId?: string): AuditLogEntry[] {
    if (channelId) {
      return this.auditLogs.filter(log => log.channelId === channelId);
    }
    return [...this.auditLogs];
  }
}

