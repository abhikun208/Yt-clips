import { sleep } from '../utils/time';

export interface SafetyCheckResult {
  isSafe: boolean;
  claimType?: 'audiovisual' | 'audio' | 'composition';
  blockedTerritories?: string[];
  actionRequired?: 'none' | 'trim' | 'mute' | 'reject';
}

export class CopyrightSafetyService {
  private youtube: youtube_v3.Youtube;
  private maxWaitTimeMs = 900000; // 15 mins
  private pollIntervalMs = 60000; // 1 min

  constructor(youtubeClient: youtube_v3.Youtube) {
    this.youtube = youtubeClient;
  }

  async waitForContentIdProcessing(videoId: string): Promise<SafetyCheckResult> {
    const startTime = Date.now();
    
    while (Date.now() - startTime < this.maxWaitTimeMs) {
      try {
        const response = await this.youtube.videos.list({
          id: [videoId],
          part: ['contentDetails', 'status'],
        });

        const video = response.data.items?.[0];
        if (!video) throw new Error('Video not found during polling');

        // Check for Content ID claims
        const contentRating = video.contentDetails?.contentRating;
        const status = video.status;

        // If no rating and privacy is unlisted, still processing
        if (!contentRating && status?.privacyStatus === 'unlisted') {
          console.log(`⏳ Waiting for Content ID... ${Math.round((Date.now() - startTime) / 1000)}s`);
          await sleep(this.pollIntervalMs);
          continue;
        }

        // Analyze result
        return this.analyzeSafety(video);

      } catch (error) {
        console.error('Polling error:', error);
        await sleep(this.pollIntervalMs);
      }
    }

    // Timeout reached
    return { 
      isSafe: false, 
      actionRequired: 'reject',
      claimType: 'timeout' 
    };
  }

  private analyzeSafety(video: youtube_v3.Schema$Video): SafetyCheckResult {
    const contentRating = video.contentDetails?.contentRating;
    
    // No claims found
    if (!contentRating || Object.keys(contentRating).length === 0) {
      return { isSafe: true, actionRequired: 'none' };
    }

    // Has claims - determine type and action
    const hasAudioClaim = !!contentRating.ytRating;
    const hasVisualClaim = !!contentRating.mpaaRating; // Simplified check
    
    return {
      isSafe: false,
      claimType: hasAudioClaim ? 'audio' : 'audiovisual',
      actionRequired: hasAudioClaim ? 'mute' : 'trim',
      blockedTerritories: [] // Fetch from rights management API if needed
    };
  }

  async handleClaim(videoId: string, result: SafetyCheckResult): Promise<boolean> {
    if (result.actionRequired === 'mute') {
      // Use YouTube Editor API to mute segment
      console.log(`🔇 Muting claimed audio segment for ${videoId}`);
      // Implementation depends on YouTube Editor API access
      return true;
    }
    
    if (result.actionRequired === 'trim') {
      console.log(`️ Trimming claimed visual segment for ${videoId}`);
      // Trigger local re-render with trim points
      return false; // Requires re-upload
    }

    // Reject
    await this.youtube.videos.delete({ id: videoId });
    console.log(`🗑️ Deleted unsafe video: ${videoId}`);
    return false;
  }
}

