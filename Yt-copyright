import { youtube_v3 } from 'googleapis';
import { EventEmitter } from 'events';

export interface ChannelConfig {
  channelId: string;
  clientEmail: string;
  privateKey: string;
  maxDailyUploads: number;
  scanTimes: string[]; // e.g., ["09:00", "14:00", "20:00"]
}

