export class PostPublicMonitor {
  private youtube: youtube_v3.Youtube;
  private readonly RE_SCAN_INTERVAL_MS = 7 * 24 * 60 * 60 * 1000; // 7 days

  constructor(youtubeClient: youtube_v3.Youtube) {
    this.youtube = youtubeClient;
  }

  /**
   * Starts weekly monitoring loop for all published videos
   */
  startMonitoring(channelId: string): void {
    console.log(`🔄 Started post-public monitoring for channel: ${channelId}`);
    
    setInterval(async () => {
      await this.scanPublishedVideos(channelId);
    }, this.RE_SCAN_INTERVAL_MS);
  }

  private async scanPublishedVideos(channelId: string): Promise<void> {
    try {
      // Fetch all published videos
      const searchResponse = await this.youtube.search.list({
        part: ['snippet'],
        channelId: channelId,
        type: 'video',
        maxResults: 50,
        order: 'date'
      });

      const videoIds = searchResponse.data.items?.map(item => item.id?.videoId).filter(Boolean) as string[];
      if (!videoIds.length) return;

      // Check status of each video
      const statusResponse = await this.youtube.videos.list({
        id: videoIds.slice(0, 50), // API limit
        part: ['contentDetails', 'status']
      });

      for (const video of statusResponse.data.items || []) {
        const contentRating = video.contentDetails?.contentRating;
        const hasNewClaim = contentRating && Object.keys(contentRating).length > 0;

        if (hasNewClaim && video.status?.privacyStatus === 'public') {
          console.warn(`⚠️ New claim detected on published video: ${video.id}`);
          await this.handlePostPublicClaim(video.id!, contentRating);
        }
      }
    } catch (error) {
      console.error('Post-public scan error:', error);
    }
  }

  private async handlePostPublicClaim(
    videoId: string,
    rating: youtube_v3.Schema$ContentRating
  ): Promise<void> {
    const hasAudioClaim = !!rating.ytRating;
    const hasVisualClaim = !!rating.filmRating || !!rating.tvRating;

    if (hasAudioClaim && !hasVisualClaim) {
      // Option 1: Replace audio
      console.log(`🎵 Replacing audio for: ${videoId}`);
      // TODO: YouTube Editor API replace
    } else if (hasVisualClaim) {
      // Option 2: Unlist immediately
      console.log(`🔒 Unlisting video due to visual claim: ${videoId}`);
      await this.youtube.videos.update({
        part: ['status'],
        requestBody: {
          id: videoId,
          status: { privacyStatus: 'unlisted' }
        }
      });
      // Trigger rerender queue
      console.log(`🔄 Added to rerender queue: ${videoId}`);
    } else {
      // Full block risk
      console.log(`🚨 High risk claim on: ${videoId}. Setting private.`);
      await this.youtube.videos.update({
        part: ['status'],
        requestBody: {
          id: videoId,
          status: { privacyStatus: 'private' }
        }
      });
    }
  }
}

