import { youtube_v3 } from 'googleapis';

export class CopyrightSafetyEngine {
  private youtube: youtube_v3.Youtube;
  private readonly MAX_POLL_ATTEMPTS = 15; // 15 minutes max
  private readonly POLL_INTERVAL_MS = 60000; // 1 minute

  constructor(youtubeClient: youtube_v3.Youtube) {
    this.youtube = youtubeClient;
  }

  /**
   * Polls YouTube API until Content ID processing completes
   * Returns safety assessment with recommended action
   */
  async waitForContentIdProcessing(videoId: string): Promise<SafetyCheckResult> {
    for (let attempt = 0; attempt < this.MAX_POLL_ATTEMPTS; attempt++) {
      try {
        const response = await this.youtube.videos.list({
          id: [videoId],
          part: ['contentDetails', 'status', 'snippet'],
        });

        const video = response.data.items?.[0];
        if (!video) {
          throw new Error(`Video ${videoId} not found during polling`);
        }

        const contentRating = video.contentDetails?.contentRating;
        const hasClaims = contentRating && Object.keys(contentRating).length > 0;

        // No claims after full processing time = SAFE
        if (!hasClaims && video.status?.privacyStatus === 'unlisted') {
          return {
            isSafe: true,
            actionRequired: 'none',
            confidence: 0.95
          };
        }

        // Claims detected - analyze type
        if (hasClaims) {
          return this.analyzeClaim(video, contentRating!);
        }

        // Still processing, wait and retry
        console.log(`⏳ Content ID processing... Attempt ${attempt + 1}/${this.MAX_POLL_ATTEMPTS}`);
        await new Promise(resolve => setTimeout(resolve, this.POLL_INTERVAL_MS));

      } catch (error) {
        console.error(`Polling error for ${videoId}:`, error);
        await new Promise(resolve => setTimeout(resolve, this.POLL_INTERVAL_MS));
      }
    }

    // Timeout reached
    return {
      isSafe: false,
      claimType: 'timeout',
      actionRequired: 'unlist',
      confidence: 0.5
    };
  }

  private analyzeClaim(
    video: youtube_v3.Schema$Video,
    rating: youtube_v3.Schema$ContentRating
  ): SafetyCheckResult {
    const hasAudioClaim = !!rating.ytRating || !!rating.mpaaRating;
    const hasVisualClaim = !!rating.filmRating || !!rating.tvRating;

    // Determine action based on claim type
    let action: SafetyCheckResult['actionRequired'] = 'delete';
    let claimType: SafetyCheckResult['claimType'] = 'audiovisual';

    if (hasAudioClaim && !hasVisualClaim) {
      action = 'mute'; // Can replace audio via Editor API
      claimType = 'audio';
    } else if (hasVisualClaim && !hasAudioClaim) {
      action = 'trim'; // Need to cut segment
      claimType = 'audiovisual';
    } else if (hasAudioClaim && hasVisualClaim) {
      action = 'delete'; // Too risky, rerender needed
      claimType = 'composition';
    }

    return {
      isSafe: false,
      claimType,
      actionRequired: action,
      confidence: 0.9
    };
  }

  /**
   * Executes the determined safety action
   */
  async executeSafetyAction(videoId: string, result: SafetyCheckResult): Promise<boolean> {
    switch (result.actionRequired) {
      case 'none':
        return true;

      case 'mute':
        console.log(`🔇 Muting claimed audio segment: ${videoId}`);
        // TODO: Integrate YouTube Editor API for mute
        return false; // Requires manual review or rerender

      case 'trim':
        console.log(`✂️ Trimming claimed segment: ${videoId}`);
        // TODO: Trigger FFmpeg re-render with trim points
        return false;

      case 'unlist':
        console.log(`🔒 Setting video to unlisted: ${videoId}`);
        await this.youtube.videos.update({
          part: ['status'],
          requestBody: {
            id: videoId,
            status: { privacyStatus: 'unlisted' }
          }
        });
        return false;

      case 'delete':
        console.log(`🗑️ Deleting unsafe video: ${videoId}`);
        await this.youtube.videos.delete({ id: videoId });
        return false;

      default:
        return false;
    }
  }
}

