export class FFMpegSafetyFilters {
  
  /**
   * Applies legit transformative filters to avoid Content ID matching
   * Fixes: Visible watermarks, raw audio fingerprint
   */
  static async applySafetyTransformations(inputPath: string, outputPath: string): Promise<void> {
    const filterComplex = [
      // Visual: Zoom 5-8% dynamically to break frame hash
      'zoompan=z=\'min(zoom+0.002,1.08)\':d=1:x=\'iw/2-(iw/zoom/2)\':y=\'ih/2-(ih/zoom/2)\':s=1080x1920',
      
      // Visual: Color grade shift (+5% brightness, +3% contrast, +6% saturation)
      'eq=brightness=0.05:contrast=1.03:saturation=1.06',
      
      // Visual: Edge blur/vignette to hide corner watermarks
      'vignette=angle=0.5',
      
      // Audio: Speed 1.03x + Pitch shift ±1.5% (legit transformation)
      'atempo=1.03,asetrate=48000*1.03',
      
      // Audio: Add -18dB royalty-free BGM layer for masking
      'amix=inputs=2:duration=first:dropout_transition=0'
    ].join(',');

    const cmd = `ffmpeg -i "${inputPath}" -i bgm_track.mp3 -filter_complex "${filterComplex}" -c:v libx264 -preset fast -crf 23 -c:a aac -b:a 128k -movflags +faststart "${outputPath}" -y`;
    
    await execAsync(cmd);
  }

  /**
   * Auto-crops detected watermark regions
   * @param coords [x1,y1,x2,y2] in pixels
   */
  static async cropWatermark(inputPath: string, outputPath: string, coords: [number, number, number, number]): Promise<void> {
    const [x1, y1, x2, y2] = coords;
    const width = x2 - x1;
    const height = y2 - y1;
    
    // Create blurred overlay for watermark region
    const cmd = `ffmpeg -i "${inputPath}" -vf "drawbox=x=${x1}:y=${y1}:w=${width}:h=${height}:color=black@0.7:t=fill" "${outputPath}" -y`;
    await execAsync(cmd);
  }
}

