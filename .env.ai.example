# Simplest setup: copy this file to ".env" in the project folder, paste ONLY the keys you have, restart.
#   cp .env.ai.example .env        (Termux/Linux)
# Model names are pre-set (src/ai/providers.json). The app detects the provider, picks a working model, tests it for real and shows Connected/Error
# in Setup -> "AI keys". Terminal check:  npm run cli -- env-check
# No quotes needed. Do not commit this file (.env is git-ignored).
GROQ_API_KEY=
GEMINI_API_KEY=
# GEMINI_API_KEY_2=      # extra key of the same provider (fallback when key 1 is busy/limited); _3 _4 _5 also work
OPENROUTER_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=       # free tier (csk-...)
# SAMBANOVA_API_KEY=     # free tier
# NVIDIA_API_KEY=        # build.nvidia.com free credits (nvapi-...)
# HF_TOKEN=              # huggingface.co/settings/tokens (hf_...)
# DEEPSEEK_API_KEY=  OPENAI_API_KEY=  TOGETHER_API_KEY=     # paid (cheap)
# ANY other OpenAI-compatible provider: set both (the app tests it for real and picks a working model)
# AI_API_KEY=
# AI_API_BASE=https://your-provider.example/v1
# A variable with a different name (e.g. MY_GEMINI_KEY=AIza...) is also recognised by the key's prefix (gsk_, AIza, sk-or-, xai-, csk-, nvapi-, hf_).
# Local Ollama (no key): remove the leading # and run `ollama pull llama3.2` first
# OLLAMA=1
