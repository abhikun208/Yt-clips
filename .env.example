# REQUIRED when HOST is not 127.0.0.1 (Docker/VPS/PaaS). Long random string, >= 12 chars. Example: openssl rand -hex 24
YT_CLIPS_TOKEN=
HOST=0.0.0.0
PORT=8080
YT_CLIPS_DATA_DIR=/data
AUTO_RUN=1                 # background worker + source polling
LOOP_SECONDS=30
MAX_UPLOAD_MB=2048
LOG_LEVEL=info
# Optional
# YT_DLP_EXTRA_ARGS=--js-runtimes node
# YT_CLIPS_STT_CMD=/path/to/custom-stt   (prints {"language","segments":[{"start","end","text","words":[...]}]})
# YT_OAUTH_CLIENT_ID=...  YT_OAUTH_CLIENT_SECRET=...   (Google OAuth client, 'TVs and Limited Input devices')
# YT_CLIPS_SECRET_KEY=long-passphrase   (encrypts stored refresh token)
# LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=...  LLM_API_KEY=...   (optional metadata polish)
# STT_API_KEY=gsk_...  (Groq free key; or save it in the UI)   STT_API_BASE=https://api.groq.com/openai/v1   STT_API_MODEL=whisper-large-v3-turbo
# LLM_API_KEY=gsk_...   LLM_API_BASE=...   LLM_API_MODEL=llama-3.3-70b-versatile
# PUBLIC_URL=https://your.domain   (used for OAuth redirect URIs behind a proxy)
# NOTE: publishing/comment gates are NOT environment settings. They can only be enabled by the owner editing data/config.json.
